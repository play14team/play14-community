{
  "kind": "collectionType",
  "collectionName": "games",
  "info": {
    "singularName": "game",
    "pluralName": "games",
    "displayName": "game"
  },
  "options": {
    "comment": ""
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["Game", "IceBreaker", "WarmUp", "Facilitation", "Retrospective", "CoolDown"],
      "required": true
    },
    "documentedBy": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::player.player",
      "inversedBy": "documented"
    },
    "proposedBy": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::player.player",
      "inversedBy": "proposed"
    },
    "firstPlayedAt": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::event.event"
    },
    "scale": {
      "type": "string"
    },
    "timebox": {
      "type": "string"
    },
    "summary": {
      "type": "text"
    },
    "materials": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list",
      "required": false
    },
    "preparationSteps": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list",
      "required": false
    },
    "safety": {
      "type": "component",
      "repeatable": true,
      "component": "shared.dictionary",
      "required": false
    },
    "defaultImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": ["images"]
    },
    "resources": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["files", "images", "videos", "audios"]
    },
    "description": {
      "type": "text",
      "required": true
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list",
      "required": false
    },
    "credits": {
      "type": "string"
    },
    "ratings": {
      "type": "component",
      "repeatable": false,
      "component": "games.ratings",
      "required": false
    }
  }
}
